# Curator Discord Bot Configuration

# Discord Bot Token (From Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application / Client ID
CLIENT_ID=your_client_id_here

# Target Guild ID (Optional: leave empty for global command deployment, or set for instant guild command deployment)
GUILD_ID=

# Database File Path (Default: ./data/curator.db)
DATABASE_PATH=./data/curator.db

# Default Bot Prefix (For legacy text commands if enabled)
DEFAULT_PREFIX=!
